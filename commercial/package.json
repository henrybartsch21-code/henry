{
  "name": "swellora-commercial",
  "version": "1.0.0",
  "private": true,
  "description": "SWELLORA — 30s Premium Motion Design Commercial (Remotion, 1080x1920, 60 FPS)",
  "scripts": {
    "assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-assets.mts",
    "studio": "npm run assets && remotion studio",
    "render": "npm run assets && remotion render SwelloraCommercial out/swellora-commercial.mp4",
    "still": "remotion still SwelloraCommercial",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@remotion/cli": "^4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
